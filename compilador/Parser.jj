options {
  STATIC = false;
}

PARSER_BEGIN(Parser)

package main;

@SuppressWarnings("all")
public class Parser {
  public java.util.List<String[]> erroresSintacticos = new java.util.ArrayList<>();

  private void recuperarError(ParseException e) {
      Token t = (e.currentToken != null && e.currentToken.next != null)
              ? e.currentToken.next : e.currentToken;
      int linea = (t != null) ? t.beginLine : -1;
      int columna = (t != null) ? t.beginColumn : -1;
      erroresSintacticos.add(new String[]{
          String.valueOf(linea), String.valueOf(columna), e.getMessage()
      });
      // Modo pánico: saltar tokens hasta el próximo ';' o EOF
      Token siguiente = getToken(1);
      while (siguiente.kind != PUNTO_Y_COMA && siguiente.kind != EOF) {
          getNextToken();
          siguiente = getToken(1);
      }
      if (siguiente.kind == PUNTO_Y_COMA) {
          getNextToken(); // consumir también el ';' para arrancar limpio la siguiente declaración
      }
  }
  public static String descripcionErrorLexico(Token token) {
    if (token != null && token.image != null
          && token.image.matches("([0-9]+\\.[0-9]*([\\.,][0-9]+)+|[0-9]+[eE][+-]?[0-9]+\\.[0-9]+|[0-9]+\\.[0-9]+(\\*|/|\\+|-)[0-9]+|[0-9]+\\.\\.[0-9]+)")) {
      return "N\u00famero mal formado.";
    }
    if (token != null && token.image != null
        && (token.image.startsWith("\"") || token.image.startsWith("'")
            || token.image.startsWith("`"))) {
      return "Cadena sin cerrar.";
    }
    if (token != null && token.image != null && token.image.matches("[0-9].*")) {
      return "N\u00famero mal formado.";
    }
    if (token != null && token.image != null
        && token.image.matches("[A-Za-z_$][A-Za-z0-9_$]*(#|[+*/%=&|^~<>!?-])[A-Za-z0-9_$#]*")) {
      return "Identificador o palabra reservada mal formada.";
    }
    return "S\u00edmbolo no reconocido.";
  }
}

PARSER_END(Parser)

SKIP :
{
    " " | "\t" | "\r" | "\n"
}

SKIP :
{
    < COMENTARIO_LINEA: "//" (~["\r", "\n"])* ("\r\n" | "\r" | "\n")? >
  | < COMENTARIO_BLOQUE: "/" "*" (~["*"] | "*" ~["/"])* "*" "/" >
}

//PALABRAS RESERVADAS
TOKEN :
{
    < BREAK: "break" > | < CASE: "case" > | < CATCH: "catch" > | < CLASS: "class" > | < CONST: "const" >
  | < CONTINUE: "continue" > | < DEBUGGER: "debugger" > | < DEFA: "default" > | < DELETE: "delete" >
  | < DO: "do" > | < ELSE: "else" > | < ENUM: "enum" > | < EXPORT: "export" > | < EXTENDS: "extends" >
  | < FINALLY: "finally" > | < FOR: "for" > | < FUNCTION: "function" > | < IF: "if" >
  | < IMPORT: "import" > | < IN: "in" > | < INSTANCEOF: "instanceof" > | < NEW: "new" >
  | < RETURN: "return" > | < SUPER: "super" > | < SWITCH: "switch" > | < THIS: "this" >
  | < THROW: "throw" > | < TRY: "try" > | < TYPEOF: "typeof" > | < VAR: "var" > | < VOID: "void" >
  | < WHILE: "while" > | < WITH: "with" > | < LET: "let" > | < STATIC: "static" > | < YIELD: "yield" >
  | < AWAIT: "await" > | < INTERFACE: "interface" > | < PACKAGE: "package" > | < PRIVATE: "private" >
  | < PROTECTED: "protected" > | < PUBLIC: "public" > | < IMPLEMENTS: "implements" >
  | < TRUE: "true" > | < FALSE: "false" >
}

TOKEN :
{
    < TIPO_ANY: "any" > | < TIPO_NUMBER: "number" > | < TIPO_BOOLEAN: "boolean" > 
    | < TIPO_STRING: "string" > | < TIPO_SYMBOL: "symbol" > | < TIPO_NEVER: "never" > 
    | < TIPO_UNKNOWN: "unknown" > | < TIPO_UNDEFINED: "undefined" >
}

TOKEN :
{
    < IDENTIFICADOR: ["A"-"Z", "a"-"z", "_", "$"]
                      (["A"-"Z", "a"-"z", "0"-"9", "_", "$"])* >
}

TOKEN :
{
    < HEXADECIMAL: "0" ["x", "X"] (["0"-"9", "A"-"F", "a"-"f"])+ >
  | < BINARIO: "0" ["b", "B"] (["0", "1"])+ >
  | < OCTAL: "0" ["o", "O"] (["0"-"7"])+ >
  | < EXPONENCIAL:
        (("0" | ["1"-"9"] (["0"-"9"])*) "." (["0"-"9"])+
          | "0" | ["1"-"9"] (["0"-"9"])* )
        ["e", "E"] ("+" | "-")? (["0"-"9"])+
    >
  | < DECIMAL: ("0" | ["1"-"9"] (["0"-"9"])*) "." (["0"-"9"])+ >
  | < ENTERO: "0" | ["1"-"9"] (["0"-"9"])* >
}

TOKEN :
{
    < CADENA: "\"" ("\\" ~[] | ~["\"", "\\", "\r", "\n"])* "\""
            | "'" ("\\" ~[] | ~["'", "\\", "\r", "\n"])* "'"
            | "`" ("\\" ~[] | ~["`", "\\"])* "`" >
}

TOKEN :
{
    < INCREMENTO: "++" >
  | < DECREMENTO: "--" >
}

TOKEN :
{
    < OPERADOR_ASIGNACION: "**=" | "+=" | "-=" | "*=" | "/=" | "%=" | "=" >
  | < OPERADOR_COMPARACION: "===" | "!==" | "==" | "!=" | ">=" | "<=" | ">" | "<" >
  | < OPERADOR_LOGICO: "&&" | "||" | "!" >
  | < OPERADOR_ARITMETICO: ">>>" | "<<" | ">>" | "**" | "+" | "-" | "*" | "/" | "%" | "&" | "|" | "^" | "~" >
}

TOKEN :
{
    < PARENTESIS_APERTURA: "(" >
  | < PARENTESIS_CIERRE: ")" >
  | < CORCHETE_APERTURA: "[" >
  | < CORCHETE_CIERRE: "]" >
  | < LLAVE_APERTURA: "{" >
  | < LLAVE_CIERRE: "}" >
  | < PUNTO_Y_COMA: ";" >
  | < COMA: "," >
  | < PUNTO: "." >
  | < DOS_PUNTOS: ":" >
  | < INTERROGACION: "?" >
}

TOKEN :
{
    < ERROR_LEXICO:

        // Identificador con carácter inválido en medio
        ((["A"-"Z", "a"-"z", "_", "$"])
          (["A"-"Z", "a"-"z", "0"-"9", "_", "$"])*
          ("@" | "#" | "?")
          (["A"-"Z", "a"-"z", "0"-"9", "_", "$"])*)

      | ("\"" (~["\"", "\r", "\n"])* )
      | ("'" (~["'", "\r", "\n"])* )
      | ("`" (~["`", "\r", "\n"])* )

      | ("|" (["A"-"Z", "a"-"z", "_", "$"])
        (["A"-"Z", "a"-"z", "0"-"9", "_", "$"])* "|")

      | ("@" (["A"-"Z", "a"-"z", "_", "$"])
        (["A"-"Z", "a"-"z", "0"-"9", "_", "$"])* )

      | ("?" ("?")+)

      | ((["0"-"9"])+ ["e", "E"] ("+" | "-")?
        (["0"-"9"])+ "." (["0"-"9"])+)

      | ((["0"-"9"])+ "."
        (["A"-"Z", "a"-"z", "_", "$"])
        (["A"-"Z", "a"-"z", "0"-"9", "_", "$"])*)

      | ((["0"-"9"])+ "." (["0"-"9"])*
        ("." | ",") (["0"-"9"])+)

      | ((["0"-"9"])+
        (["A"-"Z", "a"-"z", "_", "$"])
        (["A"-"Z", "a"-"z", "0"-"9", "_", "$"])*)

      | ((["0"-"9"])+ "." (["0"-"9"])*
        ("." (["0"-"9"])+)+)

      | ((["0"-"9"])+ "." (["0"-"9"])+
        ("*" | "/" | "+" | "-")
        (["0"-"9"])+)
    >
}

void Inicio() : {}
{
    {
        while (getToken(1).kind != EOF) {
            try {
                Instruccion();
            } catch (ParseException e) {
                recuperarError(e);
            }
        }
    }
    <EOF>
}

void VariableDeclaracion() : {}
{
    <LET> <IDENTIFICADOR>
    [ <DOS_PUNTOS> Tipo() ]
    [ <OPERADOR_ASIGNACION> Expresion() ]
    <PUNTO_Y_COMA>
}

void Tipo() : {}
{
      <TIPO_NUMBER>
    | <TIPO_STRING>
    | <TIPO_BOOLEAN>
    | <TIPO_ANY>
}

void Expresion() : {}
{
    ExpresionLogica()
}

void ExpresionLogica() : {}
{
    ExpresionRelacional() ( <OPERADOR_LOGICO> ExpresionRelacional() )*
}

void ExpresionRelacional() : {}
{
    ExpresionAritmetica() [ <OPERADOR_COMPARACION> ExpresionAritmetica() ]
}

void ExpresionAritmetica() : {}
{
    Valor() ( <OPERADOR_ARITMETICO> Valor() )*
}

void Valor() : {}
{
      ( <IDENTIFICADOR> [ <INCREMENTO> | <DECREMENTO> ] )
    | <ENTERO>
    | <DECIMAL>
    | <CADENA>
    | <TRUE>
    | <FALSE>
}

void Instruccion() : {}
{
    Declaracion() | Sentencia()
}

void Declaracion() : {}
{
    VariableDeclaracion()
}

void Asignacion() : {}
{
    <IDENTIFICADOR>
    <OPERADOR_ASIGNACION>
    Expresion()
    <PUNTO_Y_COMA>
}

void Sentencia() : {}
{
      LOOKAHEAD(2) Asignacion()
    | LOOKAHEAD(2) IncrementoSentencia()
    | LOOKAHEAD(2) LlamadaFuncion() <PUNTO_Y_COMA>
    | IfSentencia()
    | ForSentencia()
    | WhileSentencia()
    | Bloque()
}

void IncrementoSentencia() : {}
{
    <IDENTIFICADOR> ( <INCREMENTO> | <DECREMENTO> ) <PUNTO_Y_COMA>
}

void Bloque() : {}
{
    <LLAVE_APERTURA>
    ( Declaracion() | Sentencia() )*
    <LLAVE_CIERRE>
}

void LlamadaFuncion() : {}
{
    <IDENTIFICADOR> ( <PUNTO> <IDENTIFICADOR> )*
    <PARENTESIS_APERTURA>
    [ Expresion() ( <COMA> Expresion() )* ]
    <PARENTESIS_CIERRE>
}

void IfSentencia() : {}
{
    <IF>
    <PARENTESIS_APERTURA>
    Expresion()
    <PARENTESIS_CIERRE>
    Bloque()
    [ <ELSE> Bloque() ]
}

void ForInit() : {}
{
    <LET> <IDENTIFICADOR>
    [ <DOS_PUNTOS> Tipo() ]
    [ <OPERADOR_ASIGNACION> Expresion() ]
}

void ForSentencia() : {}
{
    <FOR> <PARENTESIS_APERTURA>
    [ ForInit() ] <PUNTO_Y_COMA>
    [ Expresion() ] <PUNTO_Y_COMA>
    [ Expresion() ]
    <PARENTESIS_CIERRE>
    Sentencia()
}

void WhileSentencia() : {}
{
    <WHILE> <PARENTESIS_APERTURA> Expresion() <PARENTESIS_CIERRE> Sentencia()
}