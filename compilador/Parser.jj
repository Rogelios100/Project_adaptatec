options {
  STATIC = false;
}

PARSER_BEGIN(Parser)

package main;
import control.erroresS;

@SuppressWarnings("all")
public class Parser {

    public java.util.List<String[]> erroresSintacticos =
            new java.util.ArrayList<>();

    public boolean tieneErroresSintacticos() {
      return !erroresSintacticos.isEmpty();
    }

private void registrarError(ParseException e) {
  Token encontrado = getToken(1);
  int linea = encontrado != null ? encontrado.beginLine : -1;
  int columna = encontrado != null ? encontrado.beginColumn : -1;
  String lexema = encontrado != null ? encontrado.image : "fin de archivo";
  erroresSintacticos.add(new String[]{String.valueOf(linea), String.valueOf(columna),
      lexema, erroresS.tokensEsperados(e), erroresS.descripcionAmigable(e, encontrado)});
}

private void recuperarError(ParseException e) {
  registrarError(e);
  Token anterior = getToken(1);

    Token siguiente = getToken(1);
    while (siguiente.kind != EOF
            && siguiente.kind != PUNTO_Y_COMA
            && siguiente.kind != LET
            && siguiente.kind != CONST
            && siguiente.kind != VAR
            && siguiente.kind != IF
            && siguiente.kind != FOR
            && siguiente.kind != FUNCTION
            && siguiente.kind != WHILE
            && siguiente.kind != LLAVE_APERTURA
            && siguiente.kind != LLAVE_CIERRE) {
        getNextToken();
        siguiente = getToken(1);
    }

    if (siguiente.kind == PUNTO_Y_COMA) {
        getNextToken();
    } else if (siguiente.kind == LLAVE_CIERRE) {
        getNextToken();
    }
    if (getToken(1) == anterior && getToken(1).kind != EOF) {
      getNextToken();
    }
}

private boolean siguienteEsFlecha() {
  if (getToken(1).kind != PARENTESIS_APERTURA) return false;
  int profundidad = 0;
  for (int posicion = 1; posicion < 256; posicion++) {
    int kind = getToken(posicion).kind;
    if (kind == PARENTESIS_APERTURA) profundidad++;
    if (kind == PARENTESIS_CIERRE) {
      profundidad--;
      if (profundidad == 0) {
        for (int despues = posicion + 1; despues < 256; despues++) {
          int siguiente = getToken(despues).kind;
          if (siguiente == FLECHA) return true;
          if (siguiente == PUNTO_Y_COMA || siguiente == LLAVE_APERTURA
              || siguiente == LLAVE_CIERRE || siguiente == EOF) return false;
        }
        return false;
      }
    }
    if (kind == EOF) return false;
  }
  return false;
}

private boolean siguienteEsForOf() {
  for (int posicion = 1; posicion < 256; posicion++) {
    int kind = getToken(posicion).kind;
    if (kind == OF || kind == IN) return true;
    if (kind == PUNTO_Y_COMA || kind == PARENTESIS_CIERRE || kind == EOF) return false;
  }
  return false;
}

  public static String descripcionErrorLexico(Token token) {
    if (token != null && token.image != null
          && token.image.matches("([0-9]+\\.[0-9]*([\\.,][0-9]+)+|[0-9]+[eE][+-]?[0-9]+\\.[0-9]+|[0-9]+\\.[0-9]+(\\*|/|\\+|-)[0-9]+|[0-9]+\\.\\.[0-9]+)")) {
      return "N\u00famero mal formado.";
    }
    if (token != null && token.image != null
        && (token.image.startsWith("\"") || token.image.startsWith("'")
            || token.image.startsWith("`"))) {
      return "Cadena sin cerrar.";
    }
    if (token != null && token.image != null && token.image.matches("[0-9].*")) {
      return "N\u00famero mal formado.";
    }
    if (token != null && token.image != null
        && token.image.matches("[A-Za-z_$][A-Za-z0-9_$]*(#|[+*/%=&|^~<>!?-])[A-Za-z0-9_$#]*")) {
      return "Identificador o palabra reservada mal formada.";
    }
    return "S\u00edmbolo no reconocido.";
  }
}

PARSER_END(Parser)

SKIP :
{
    " " | "\t" | "\r" | "\n"
}

SKIP :
{
    < COMENTARIO_LINEA: "//" (~["\r", "\n"])* ("\r\n" | "\r" | "\n")? >
  | < COMENTARIO_BLOQUE: "/" "*" (~["*"] | "*" ~["/"])* "*" "/" >
}

//PALABRAS RESERVADAS
TOKEN :
{
    < BREAK: "break" > | < CASE: "case" > | < CATCH: "catch" > | < CLASS: "class" > | < CONST: "const" >
  | < CONTINUE: "continue" > | < DEBUGGER: "debugger" > | < DEFA: "default" > | < DELETE: "delete" >
  | < DO: "do" > | < ELSE: "else" > | < ENUM: "enum" > | < EXPORT: "export" > | < EXTENDS: "extends" >
  | < FINALLY: "finally" > | < FOR: "for" > | < FUNCTION: "function" > | < IF: "if" >
  | < IMPORT: "import" > | < IN: "in" > | < INSTANCEOF: "instanceof" > | < NEW: "new" >
  | < RETURN: "return" > | < SUPER: "super" > | < SWITCH: "switch" > | < THIS: "this" >
  | < THROW: "throw" > | < TRY: "try" > | < TYPEOF: "typeof" > | < VAR: "var" > | < VOID: "void" >
  | < WHILE: "while" > | < WITH: "with" > | < LET: "let" > | < STATIC: "static" > | < YIELD: "yield" >
  | < AWAIT: "await" > | < INTERFACE: "interface" > | < PACKAGE: "package" > | < PRIVATE: "private" >
  | < PROTECTED: "protected" > | < PUBLIC: "public" > | < IMPLEMENTS: "implements" >
  | < TRUE: "true" > | < FALSE: "false" > | < OF: "of" > | < CONSTRUCTOR: "constructor" >
}

TOKEN :
{
    < FLECHA: "=>" >
}

TOKEN :
{
    < TIPO_ANY: "any" > | < TIPO_NUMBER: "number" > | < TIPO_BOOLEAN: "boolean" > 
    | < TIPO_STRING: "string" > | < TIPO_SYMBOL: "symbol" > | < TIPO_NEVER: "never" > 
    | < TIPO_UNKNOWN: "unknown" > | < TIPO_UNDEFINED: "undefined" >
}

TOKEN :
{
    < IDENTIFICADOR: ["A"-"Z", "a"-"z", "_", "$"]
                      (["A"-"Z", "a"-"z", "0"-"9", "_", "$"])* >
}

TOKEN :
{
    < HEXADECIMAL: "0" ["x", "X"] (["0"-"9", "A"-"F", "a"-"f"])+ >
  | < BINARIO: "0" ["b", "B"] (["0", "1"])+ >
  | < OCTAL: "0" ["o", "O"] (["0"-"7"])+ >
  | < EXPONENCIAL:
        (("0" | ["1"-"9"] (["0"-"9"])*) "." (["0"-"9"])+
          | "0" | ["1"-"9"] (["0"-"9"])* )
        ["e", "E"] ("+" | "-")? (["0"-"9"])+
    >
  | < DECIMAL: ("0" | ["1"-"9"] (["0"-"9"])*) "." (["0"-"9"])+ >
  | < ENTERO: "0" | ["1"-"9"] (["0"-"9"])* >
}

TOKEN :
{
    < CADENA: "\"" ("\\" ~[] | ~["\"", "\\", "\r", "\n"])* "\""
            | "'" ("\\" ~[] | ~["'", "\\", "\r", "\n"])* "'"
            | "`" ("\\" ~[] | ~["`", "\\"])* "`" >
}

TOKEN :
{
    < INCREMENTO: "++" >
  | < DECREMENTO: "--" >
}

TOKEN :
{
    < OPERADOR_ASIGNACION: "**=" | "+=" | "-=" | "*=" | "/=" | "%=" | "=" >
  | < OPERADOR_COMPARACION: "===" | "!==" | "==" | "!=" | ">=" | "<=" | ">" | "<" >
  | < OPERADOR_LOGICO: "&&" | "||" | "!" >
  | < OPERADOR_ARITMETICO: ">>>" | "<<" | ">>" | "**" | "+" | "-" | "*" | "/" | "%" | "&" | "|" | "^" | "~" >
}

TOKEN :
{
    < PARENTESIS_APERTURA: "(" >
  | < PARENTESIS_CIERRE: ")" >
  | < CORCHETE_APERTURA: "[" >
  | < CORCHETE_CIERRE: "]" >
  | < LLAVE_APERTURA: "{" >
  | < LLAVE_CIERRE: "}" >
  | < PUNTO_Y_COMA: ";" >
  | < COMA: "," >
  | < PUNTO: "." >
  | < DOS_PUNTOS: ":" >
  | < INTERROGACION: "?" >
}

TOKEN :
{
    < ERROR_LEXICO:

        // Identificador con carácter inválido en medio
        ((["A"-"Z", "a"-"z", "_", "$"])
          (["A"-"Z", "a"-"z", "0"-"9", "_", "$"])*
          ("@" | "#")
          (["A"-"Z", "a"-"z", "0"-"9", "_", "$"])*)

      | ("\"" (~["\"", "\r", "\n"])* )
      | ("'" (~["'", "\r", "\n"])* )
      | ("`" (~["`", "\r", "\n"])* )

      | ("|" (["A"-"Z", "a"-"z", "_", "$"])
        (["A"-"Z", "a"-"z", "0"-"9", "_", "$"])* "|")

      | ("@" (["A"-"Z", "a"-"z", "_", "$"])
        (["A"-"Z", "a"-"z", "0"-"9", "_", "$"])* )

      | ("?" ("?")+)

      | ((["0"-"9"])+ ["e", "E"] ("+" | "-")?
        (["0"-"9"])+ "." (["0"-"9"])+)

      | ((["0"-"9"])+ "."
        (["A"-"Z", "a"-"z", "_", "$"])
        (["A"-"Z", "a"-"z", "0"-"9", "_", "$"])*)

      | ((["0"-"9"])+ "." (["0"-"9"])*
        ("." | ",") (["0"-"9"])+)

      | ((["0"-"9"])+
        (["A"-"Z", "a"-"z", "_", "$"])
        (["A"-"Z", "a"-"z", "0"-"9", "_", "$"])*)

      | ((["0"-"9"])+ "." (["0"-"9"])*
        ("." (["0"-"9"])+)+)

      | ((["0"-"9"])+ "." (["0"-"9"])+
        ("*" | "/" | "+" | "-")
        (["0"-"9"])+)

      | ~[]
    >
}

void Inicio() : {}
{
    {
        Token anterior;
        while (getToken(1).kind != EOF) {
            anterior = getToken(1);
            try {
                Instruccion();
            } catch (ParseException e) {
                recuperarError(e);
            }
            // Seguro anti-bucle infinito: si tras un intento completo
            // (parseo + recuperación) seguimos exactamente en el mismo token,
            // forzamos avanzar uno para garantizar progreso siempre.
            if (getToken(1) == anterior && getToken(1).kind != EOF) {
                getNextToken();
            }
        }
    }
    <EOF>
}

void VariableDeclaracion() : {}
{
  (<LET> | <CONST> | <VAR>) <IDENTIFICADOR>
  [ <DOS_PUNTOS> Tipo() ] [ <OPERADOR_ASIGNACION> Expresion() ]
  [ <PUNTO_Y_COMA> ]
}

void Tipo() : {}
{
  TipoBase() ( <CORCHETE_APERTURA> <CORCHETE_CIERRE> )*
  | <CORCHETE_APERTURA> [ Tipo() ( <COMA> Tipo() )* ] <CORCHETE_CIERRE>
}

void TipoBase() : {}
{
    <TIPO_NUMBER> | <TIPO_STRING> | <TIPO_BOOLEAN> | <TIPO_ANY>
  | <TIPO_UNKNOWN> | <TIPO_NEVER> | <TIPO_UNDEFINED> | <VOID>
  | <IDENTIFICADOR>
}

void Expresion() : {}
{
  ExpresionAsignacion()
}

void ExpresionAsignacion() : {}
{
  ExpresionTernaria()
  [ <OPERADOR_ASIGNACION> ExpresionAsignacion() ]
}

void ExpresionTernaria() : {}
{
  ExpresionLogica() [ <INTERROGACION> Expresion() <DOS_PUNTOS> Expresion() ]
}

void ExpresionLogica() : {}
{
  ExpresionRelacional() ( <OPERADOR_LOGICO> ExpresionRelacional() )*
}

void ExpresionRelacional() : {}
{
  ExpresionAritmetica() ( <OPERADOR_COMPARACION> ExpresionAritmetica() )*
}

void ExpresionAritmetica() : {}
{
  Factor() ( <OPERADOR_ARITMETICO> Factor() )*
}

void Factor() : {}
{
  [ <OPERADOR_LOGICO> | <OPERADOR_ARITMETICO> ] Valor()
}

void Valor() : {}
{
    LOOKAHEAD( {siguienteEsFlecha()} ) FlechaFuncion()
  | LOOKAHEAD(3) <IDENTIFICADOR> [ <INTERROGACION> ] [ <DOS_PUNTOS> Tipo() ] <FLECHA> Expresion()
  | Primario() [ <INCREMENTO> | <DECREMENTO> ]
}

void Primario() : {}
{
  ( <IDENTIFICADOR> | <THIS> ) ( <PUNTO> <IDENTIFICADOR> | LlamadaArgumentos() | AccesoArreglo() )*
  | <NEW> <IDENTIFICADOR> [ LlamadaArgumentos() ]
  | <ENTERO> | <DECIMAL> | <EXPONENCIAL> | <HEXADECIMAL> | <BINARIO> | <OCTAL>
  | <CADENA> | <TRUE> | <FALSE> | ArregloLiteral() | ObjetoLiteral()
  | <PARENTESIS_APERTURA> Expresion() <PARENTESIS_CIERRE>
}

void LlamadaArgumentos() : {}
{
  <PARENTESIS_APERTURA> [ Expresion() ( <COMA> Expresion() )* ] <PARENTESIS_CIERRE>
}

void AccesoArreglo() : {}
{
  <CORCHETE_APERTURA> Expresion() <CORCHETE_CIERRE>
}

void ArregloLiteral() : {}
{
  <CORCHETE_APERTURA> [ Expresion() ( <COMA> Expresion() )* ] <CORCHETE_CIERRE>
}

void ObjetoLiteral() : {}
{
  <LLAVE_APERTURA> [ PropiedadObjeto() ( <COMA> PropiedadObjeto() )* [ <COMA> ] ] <LLAVE_CIERRE>
}

void PropiedadObjeto() : {}
{
  ( <IDENTIFICADOR> | <CADENA> ) [ <DOS_PUNTOS> Expresion() ]
}

void FlechaFuncion() : {}
{
  <PARENTESIS_APERTURA> [ Parametro() ( <COMA> Parametro() )* ] <PARENTESIS_CIERRE>
  [ <DOS_PUNTOS> Tipo() ] <FLECHA> ( Bloque() | Expresion() )
}

void Parametro() : {}
{
  <IDENTIFICADOR> [ <INTERROGACION> ] [ <DOS_PUNTOS> Tipo() ]
}

void Instruccion() : {}
{
  InterfaceDeclaracion() | EnumDeclaracion() | ClaseDeclaracion()
  | Declaracion() | FuncionDeclaracion() | Sentencia()
}

void InterfaceDeclaracion() : {}
{
  <INTERFACE> <IDENTIFICADOR> <LLAVE_APERTURA>
  ( InterfaceMiembro() )*
  <LLAVE_CIERRE>
}

void InterfaceMiembro() : {}
{
  LOOKAHEAD(2) MetodoFirma()
  | <IDENTIFICADOR> [ <INTERROGACION> ] [ <DOS_PUNTOS> Tipo() ] [ <PUNTO_Y_COMA> ]
}

void MetodoFirma() : {}
{
  <IDENTIFICADOR> <PARENTESIS_APERTURA>
  [ Parametro() ( <COMA> Parametro() )* ] <PARENTESIS_CIERRE>
  [ <DOS_PUNTOS> Tipo() ] [ <PUNTO_Y_COMA> ]
}

void EnumDeclaracion() : {}
{
  <ENUM> <IDENTIFICADOR> <LLAVE_APERTURA>
  [ <IDENTIFICADOR> ( <COMA> <IDENTIFICADOR> )* [ <COMA> ] ]
  <LLAVE_CIERRE>
}

void ClaseDeclaracion() : {}
{
  <CLASS> <IDENTIFICADOR> [ <EXTENDS> <IDENTIFICADOR> ]
  <LLAVE_APERTURA> ( MiembroClase() )* <LLAVE_CIERRE>
}

void MiembroClase() : {}
{
  Modificadores()
  ( ConstructorClase()
  | LOOKAHEAD(2) MetodoClase()
  | CampoClase() )
}

void Modificadores() : {}
{
  ( <PUBLIC> | <PRIVATE> | <PROTECTED> | <STATIC> )*
}

void ConstructorClase() : {}
{
  <CONSTRUCTOR> <PARENTESIS_APERTURA>
  [ Parametro() ( <COMA> Parametro() )* ] <PARENTESIS_CIERRE>
  Bloque()
}

void MetodoClase() : {}
{
  <IDENTIFICADOR> <PARENTESIS_APERTURA>
  [ Parametro() ( <COMA> Parametro() )* ] <PARENTESIS_CIERRE>
  [ <DOS_PUNTOS> Tipo() ] Bloque()
}

void CampoClase() : {}
{
  <IDENTIFICADOR> [ <INTERROGACION> ] [ <DOS_PUNTOS> Tipo() ]
  [ <OPERADOR_ASIGNACION> Expresion() ] [ <PUNTO_Y_COMA> ]
}

void Declaracion() : {}
{
  VariableDeclaracion()
}

void Asignacion() : {}
{
  ( <IDENTIFICADOR> | <THIS> ) ( <PUNTO> <IDENTIFICADOR> )*
  <OPERADOR_ASIGNACION> Expresion() <PUNTO_Y_COMA>
}

void Sentencia() : {}
{
      LOOKAHEAD(5) Asignacion()
    | LOOKAHEAD(3) IncrementoSentencia()
    | LOOKAHEAD(4) LlamadaFuncion() <PUNTO_Y_COMA>
  | IfSentencia() | ForSentencia() | WhileSentencia() | DoWhileSentencia()
  | SwitchSentencia() | ReturnSentencia() | BreakSentencia() | Bloque()
}

void IncrementoSentencia() : {}
{
  <IDENTIFICADOR> ( <INCREMENTO> | <DECREMENTO> ) <PUNTO_Y_COMA>
}

void IncrementoSentenciaSinPunto() : {}
{
  <IDENTIFICADOR> ( <INCREMENTO> | <DECREMENTO> )
}

void Bloque() : {}
{
  <LLAVE_APERTURA> ( Instruccion() )* <LLAVE_CIERRE>
}

void LlamadaFuncion() : {}
{
  ( <IDENTIFICADOR> | <THIS> ) ( <PUNTO> <IDENTIFICADOR> )* LlamadaArgumentos()
}

void FuncionDeclaracion() : {}
{
  <FUNCTION> <IDENTIFICADOR> <PARENTESIS_APERTURA>
  [ Parametro() ( <COMA> Parametro() )* ] <PARENTESIS_CIERRE>
  [ <DOS_PUNTOS> Tipo() ] Bloque()
}

void ReturnSentencia() : {}
{
  <RETURN> [ Expresion() ] [ <PUNTO_Y_COMA> ]
}

void BreakSentencia() : {}
{
  <BREAK> [ <PUNTO_Y_COMA> ]
}

void IfSentencia() : {}
{
  <IF> <PARENTESIS_APERTURA> Expresion() <PARENTESIS_CIERRE>
  Bloque() [ <ELSE> ( IfSentencia() | Bloque() ) ]
}

void ForInit() : {}
{
  (<LET> | <CONST> | <VAR>) <IDENTIFICADOR>
  [ <DOS_PUNTOS> Tipo() ] [ <OPERADOR_ASIGNACION> Expresion() ]
}

void ForSentencia() : {}
{
  <FOR> <PARENTESIS_APERTURA>
  ( LOOKAHEAD( {siguienteEsForOf()} ) ForInit() ( <OF> | <IN> ) Expresion()
  | [ ForInit() ] <PUNTO_Y_COMA> [ Expresion() ] <PUNTO_Y_COMA> [ Expresion() ] )
  <PARENTESIS_CIERRE> Sentencia()
}

void DoWhileSentencia() : {}
{
  <DO> Sentencia() <WHILE> <PARENTESIS_APERTURA> Expresion() <PARENTESIS_CIERRE>
  [ <PUNTO_Y_COMA> ]
}

void WhileSentencia() : {}
{
  <WHILE> <PARENTESIS_APERTURA> Expresion() <PARENTESIS_CIERRE> Sentencia()
}

void SwitchSentencia() : {}
{
  <SWITCH> <PARENTESIS_APERTURA> Expresion() <PARENTESIS_CIERRE>
  <LLAVE_APERTURA> ( CasoSwitch() )* <LLAVE_CIERRE>
}

void CasoSwitch() : {}
{
  ( <CASE> Expresion() | <DEFA> ) <DOS_PUNTOS>
  ( Instruccion() )*
}